{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug rust-web-basic (main)",
            "cargo": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "RUSTC": "/Users/ivan/.rustup/toolchains/stable-aarch64-apple-darwin/bin/rustc"
                },
                "args": [
                    "build",
                    "--bin=rust-web-basic",
                    "--package=rust-web-basic"
                ],
                "filter": {
                    "name": "rust-web-basic",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}",
            "sourceLanguages": [
                "rust"
            ]
        }
    ]
}
